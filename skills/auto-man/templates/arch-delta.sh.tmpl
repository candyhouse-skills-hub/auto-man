#!/bin/bash
# arch-delta.sh — mechanically-derived "system shape" summary for THIS run.
# NOT a verify.sh replacement and NOT the diff itself: this is the compressed
# input to the batch architecture review in SKILL.md Step 8. The problem it
# exists to solve: per-run diff review doesn't scale with the number of runs,
# but the fix isn't "skip review" or "read every diff" — it's compressing many
# runs' worth of *shape change* into something a human owner can read in
# O(subsystems) instead of O(diffs). See SKILL.md Step 6/Step 8.
#
# Division of labor:
#   - This script answers "what shape changed" with neutral, descriptive
#     numbers and file lists. It makes NO judgment about whether the change is
#     risky, and it does not route anything.
#   - "Is this change risky enough to warrant a full human review?" is a domain
#     judgment the human makes at Step 0, before implementation, and it travels
#     here as {{HUMAN_REVIEW_REQUESTED}}. That answer — not any heuristic in
#     this file — is what Step 6's reminder and Step 8's routing key off.
set -uo pipefail

BASE_REF="{{BASE_REF}}"  # filled at Step 2: `git rev-parse HEAD` captured right
                          # after Step 1's isolation, before any implementation commit
HUMAN_REVIEW_REQUESTED="{{HUMAN_REVIEW_REQUESTED}}"  # filled at Step 2 from the
                          # user's own Step 0 answer: "true" or "false"

# Guards check structurally (any literal "{{" left in the value) rather than
# against the placeholder tokens spelled out again — spelling one out a second
# time here would itself get overwritten by a naive find-and-replace of the
# assignment above, silently defeating this exact check.
if [ -z "$BASE_REF" ] || printf '%s' "$BASE_REF" | grep -q '{{'; then
  echo "arch-delta.sh: BASE_REF placeholder was never filled in at Step 2 — refusing to run against an undefined base." >&2
  exit 1
fi
if [ -z "$HUMAN_REVIEW_REQUESTED" ] || printf '%s' "$HUMAN_REVIEW_REQUESTED" | grep -q '{{'; then
  echo "arch-delta.sh: HUMAN_REVIEW_REQUESTED placeholder was never filled in at Step 2 — the Step 0 review question was skipped, and this row would misreport it as answered." >&2
  exit 1
fi
case "$HUMAN_REVIEW_REQUESTED" in
  true|false) ;;
  *) echo "arch-delta.sh: HUMAN_REVIEW_REQUESTED must be exactly 'true' or 'false', got: $HUMAN_REVIEW_REQUESTED" >&2; exit 1 ;;
esac

ARTIFACTS_DIR=".workflow/artifacts"
mkdir -p "$ARTIFACTS_DIR"

touched_files=$(git diff --name-only "$BASE_REF" HEAD 2>/dev/null || true)
new_files=$(git diff --name-only --diff-filter=A "$BASE_REF" HEAD 2>/dev/null || true)
deleted_files=$(git diff --name-only --diff-filter=D "$BASE_REF" HEAD 2>/dev/null || true)
shortstat=$(git diff --shortstat "$BASE_REF" HEAD 2>/dev/null || true)

files_touched=$(printf '%s\n' "$touched_files" | grep -c . || true)
diff_loc=$(printf '%s\n' "$shortstat" | grep -oE '[0-9]+ (insertion|deletion)' | grep -oE '^[0-9]+' | awk '{s+=$1} END {print s+0}')

export ARCH_NEW_FILES="$new_files"
export ARCH_DELETED_FILES="$deleted_files"
export ARCH_FILES_TOUCHED="${files_touched:-0}"
export ARCH_DIFF_LOC="${diff_loc:-0}"
export ARCH_HUMAN_REVIEW_REQUESTED="$HUMAN_REVIEW_REQUESTED"

python3 <<'PYEOF'
import json, os

def lines(name):
    v = os.environ.get(name, "")
    return [l for l in v.splitlines() if l.strip()]

row = {
    "filesTouched": int(os.environ.get("ARCH_FILES_TOUCHED", "0") or 0),
    "diffLoc": int(os.environ.get("ARCH_DIFF_LOC", "0") or 0),
    "newFiles": lines("ARCH_NEW_FILES"),
    "deletedFiles": lines("ARCH_DELETED_FILES"),
    "humanReviewRequested": os.environ.get("ARCH_HUMAN_REVIEW_REQUESTED") == "true",
}

os.makedirs(".workflow/artifacts", exist_ok=True)
with open(".workflow/artifacts/arch-delta.json", "w") as f:
    json.dump(row, f, indent=2)
print(json.dumps(row, indent=2))
PYEOF
